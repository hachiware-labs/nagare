{
  "name": "@hachiware-labs/nagare-repo",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "node scripts/install-dev-global.js",
    "build:workspace": "cargo build --workspace",
    "build:release": "cargo build --release -p nagare-cli",
    "test": "cargo test --workspace",
    "test:e2e": "playwright test",
    "test:integration:codex": "powershell -ExecutionPolicy Bypass -File tests/integration/codex-real-flow.ps1",
    "test:e2e:desktop-window": "node tests/e2e/tauri-window-smoke.mjs",
    "desktop:dev": "npm run dev --workspace @hachiware-labs/nagare-desktop",
    "desktop:build": "npm run build --workspace @hachiware-labs/nagare-desktop",
    "nagare": "node scripts/nagare-dev.js",
    "doctor": "node scripts/nagare-dev.js doctor",
    "init": "node scripts/nagare-dev.js init",
    "dev:scenario:first": "node scripts/nagare-dev.js dev scenario first",
    "pack:npm": "npm pack --workspace @hachiware-labs/nagare"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0"
  }
}
