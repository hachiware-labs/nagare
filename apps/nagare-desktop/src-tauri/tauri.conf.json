{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nagare",
  "version": "0.1.0",
  "identifier": "com.hachiwarelabs.nagare",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Nagare",
        "width": 1320,
        "height": 900,
        "minWidth": 1040,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
